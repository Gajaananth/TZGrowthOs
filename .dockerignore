# Ignore environment and secret files
.env
.env.*
.env.local
!.env.example

# Secrets and credentials
*.pem
*.key
*.p12
service-account*.json
credentials*.json

# Ignore dependency and build artifacts
node_modules/
client/node_modules/
client/dist/
dist/
coverage/
*.tsbuildinfo
*.js.map

# Ignore legacy and temporary files
_legacy/
tmp/
*.log

# Ignore git and IDE metadata
.git/
.gitignore
.vscode/
.idea/
.DS_Store
Thumbs.db
