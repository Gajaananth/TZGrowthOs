# Tradiq Zium GrowthOS — Environment Variables Template
# Copy this file to .env for local development. Never commit real credentials to Git.

# Required: Google Gemini API Key
GEMINI_API_KEY=replace_with_your_own_key

# Required: PostgreSQL connection string (Cloud SQL, Supabase, Neon, or local PostgreSQL)
DATABASE_URL=replace_with_your_postgresql_connection_string

# Required: Secret key for signing and verifying JWT tokens (min 32 characters)
JWT_SECRET=replace_with_a_long_random_secret

# Server Port (Cloud Run defaults to 8080, local defaults to 3001)
PORT=8080

# Environment mode ('development' or 'production')
NODE_ENV=production

# Optional: Override Gemini Model (default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Optional: Frontend URL for CORS (defaults to http://localhost:5173 in dev)
FRONTEND_URL=http://localhost:5173

# Optional: Additional CORS origins (comma-separated, e.g. https://your-domain.com)
CORS_ORIGINS=

# Optional: Set to true if serving Vite production build directly from Node/Express
SERVE_CLIENT=true
