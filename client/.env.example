# Tradiq Zium GrowthOS Frontend Environment Variables (Vite)
# NOTE: Only variables prefixed with VITE_ are exposed to client-side code.
# NEVER put Gemini API keys, JWT secrets, or database URLs here.

# Optional: URL of your deployed backend (e.g. on Render)
# Leave empty for local development (which uses Vite's local dev proxy to localhost:3001)
# Example for production: VITE_API_BASE_URL=https://your-backend-app.onrender.com
VITE_API_BASE_URL=
